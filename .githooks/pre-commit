#!/bin/sh
# Block commits that add secrets (API keys, tokens, private keys). Enable once per clone:
#   git config core.hooksPath .githooks
# Needs gitleaks (brew install gitleaks). Skips with a warning if it isn't installed.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed, secret scan skipped (brew install gitleaks)" >&2
    exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
