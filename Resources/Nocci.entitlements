<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The media plugin controls Spotify and Apple Music with AppleScript. Under the hardened runtime
	     (required for notarization) sending Apple Events needs this. macOS still asks the user per app. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
